# Copy to backend/.env and fill in. URL-encode special characters in passwords.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agentic_rag
# Disposable database for tests: migration tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agentic_rag_test
OLLAMA_BASE_URL=http://localhost:11434
LOG_LEVEL=INFO
LOG_JSON=false
DEFAULT_OWNER_ID=local
READINESS_TIMEOUT_S=2.0
