# Copy to backend/.env and fill in. URL-encode special characters in passwords.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agentic_rag
# Disposable database for tests: migration tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agentic_rag_test
OLLAMA_BASE_URL=http://localhost:11434
# Optional. Enables the Gemini models in config/models.yaml (free tier: https://aistudio.google.com/apikey).
# Retrieved document passages are sent to Google for these models; leave empty to stay fully local.
GOOGLE_API_KEY=
# Optional. Enables the Groq models in config/models.yaml (https://console.groq.com/keys).
# Retrieved document passages are sent to Groq for these models.
GROQ_API_KEY=
LOG_LEVEL=INFO
LOG_JSON=false
DEFAULT_OWNER_ID=local
READINESS_TIMEOUT_S=2.0
LLM_TIMEOUT_S=120.0
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
MAX_UPLOAD_BYTES=20971520
# JSON list of browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173"]
